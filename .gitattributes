# Lab scripts run on Linux (WSL or a container): a Windows checkout must never turn them into CRLF.
* text=auto
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
Dockerfile text eol=lf
# start.bat is run by Windows cmd.exe, which needs CRLF line endings.
*.bat text eol=crlf
